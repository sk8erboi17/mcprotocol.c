      "component": "instrument",
      "reason": "Official 26.1.2/26.2 instrument STREAM_CODEC uses Holder directly, without the EitherHolder Bool used by 1.21.11. Confirmed against official ItemData.java streams and the release decompiled codec.",
      "expect": [
        "container",
        [
          {
            "name": "hasHolder",
            "type": "bool"
          },
          {
            "name": "data",
            "type": [
              "switch",
              {
                "compareTo": "hasHolder",
                "fields": {
                  "true": [
                    "registryEntryHolder",
                    {
                      "baseName": "instrumentId",
                      "otherwise": {
                        "name": "data",
                        "type": "InstrumentData"
                      }
                    }
                  ],
                  "false": "string"
                }
              }
            ]
          }
        ]
      ],
      "replace": [
        "registryEntryHolder",
        {
          "baseName": "instrumentId",
          "otherwise": {
